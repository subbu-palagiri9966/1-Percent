# Copy to .env.local for local development. Never commit .env or .env.local.
#
# Address of the 1% backend API. This is public: Expo bakes EXPO_PUBLIC_* values
# into the app, so never put a secret in any EXPO_PUBLIC_* variable.
# On a physical phone, use your computer's LAN address instead of localhost,
# for example http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
