# Copy this file to .env in the repository root and replace every placeholder.
# .env is ignored by Git. Never commit it, and never put real values in this file.
#
# Used by docker-compose.yml to start the local PostgreSQL database.

# --- Local PostgreSQL container ---
POSTGRES_DB=onepercent
POSTGRES_USER=onepercent
POSTGRES_PASSWORD=replace-with-a-local-password

# Backend settings are added together with the backend, later in Phase 0.
